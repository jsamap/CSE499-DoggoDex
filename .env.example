# Copy to .env for local development. Never commit the real .env.

ASPNETCORE_ENVIRONMENT=Development

# Local Postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=doggodex;Username=doggodex;Password=change-me

# JWT (use a long random string, 32+ characters)
Jwt__Key=replace-with-a-long-random-string-at-least-32-chars
Jwt__Issuer=doggodex-api
Jwt__Audience=doggodex-web

# URLs between the two apps
Api__BaseUrl=https://localhost:5001
Cors__AllowedOrigin=https://localhost:5002
