@* Display-only rating: <StarRating Value="4.6" Count="17" /> *@
<span class="inline-flex items-center gap-2" role="img" aria-label="@Value.ToString("0.#") out of 5 stars">
    <span class="tracking-widest text-gray-900" aria-hidden="true">
        @for (var i = 1; i <= 5; i++)
        {
            @(i <= Math.Round(Value) ? "★" : "☆")
        }
    </span>
    @if (Count is not null)
    {
        <span class="text-sm text-gray-600">@Value.ToString("0.0") · @Count reviews</span>
    }
</span>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public int? Count { get; set; }
}
