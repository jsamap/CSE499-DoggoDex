{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    // Mocks are a local-development tool only. Never turn this on here: staging and
    // production inherit this file. Local development opts in via appsettings.Development.json.
    "UseMocks": false,
    "BaseUrl": "http://localhost:5099/"
  },
  "AllowedHosts": "*"
}
